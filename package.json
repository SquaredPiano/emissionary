    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "ocr:install": "cd ocr-service && pip install -r requirements.txt",
    "ocr:start": "cd ocr-service && python start.py",
    "ocr:dev": "cd ocr-service && python start.py",
    "ocr:test": "cd ocr-service && python test_ocr.py",
    "ocr:health": "curl -s http://localhost:8000/health | jq .",
    "setup:full": "npm run db:generate && npm run ocr:install && npm run build"
  },
